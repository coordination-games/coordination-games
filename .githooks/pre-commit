#!/usr/bin/env bash
# Pre-commit hook: repository boundary guard, then Biome lint + format.
# Typecheck is intentionally left to CI — too slow for pre-commit (~20s).
# To bypass (emergencies only): git commit --no-verify
set -e

if ! command -v npx >/dev/null 2>&1; then
  echo "pre-commit: npx is required to run the repository guard" >&2
  exit 1
fi

npx tsx scripts/repository-guard.ts --staged
npx biome check .
